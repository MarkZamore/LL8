	quest.0000000000000C69.quest_desc: [
		"(As prensas são encontradas em meteoritos, dentro do Cubo Misterioso, encontrado em qualquer lugar do mundo.)"
		""
		"&7> Alternativamente, você pode criar essas prensas em vez de procurá-las."
	]
	quest.0000000000000C69.quest_subtitle: "Encontre ou crie todas as prensas"
	quest.0000000000000C69.title: "As Quatro Prensas"
	quest.0000000000000C6F.quest_desc: [
		"[&e!&f] Esta bússola pode ajudá-lo a localizar meteoritos."
		""
		"&eNOTA:&f Meteoritos podem gerar na Dimensão de Mineração do Overworld também, nas mesmas coordenadas que no overworld, 1:1."
		""
		"&rCrie o Bloco do Portal da Dimensão de Mineração (Overworld) para acessá-la."
		""
		"Coloque-o, depois clique com o botão direito e você estará dentro!"
	]
	quest.0000000000000C6F.quest_subtitle: "Construa uma Bússola de Meteorito"
	quest.0000000000000C73.quest_desc: ["&5Cristal de Fluix&f é criado no mundo jogando &eCristal de Quartzo de Certus Carregado, &7Quartzo do Nether&f e &cPó de Redstone &fna água."]
	quest.0000000000000C73.quest_subtitle: "Adquira Cristais de Fluix."
	quest.0000000000000C73.title: "Isso não é Natural!"
	quest.0000000000000C75.quest_desc: [
		"Este carregador pode produzir Quartzo de Certus Carregado inserindo Quartzo de Certus normal com um clique direito."
		" "
		"Requer um pouco de energia."
	]
	quest.0000000000000C75.quest_subtitle: "Construa um Carregador"
	quest.0000000000000C75.title: "Carregando"
	quest.0000000000000C77.quest_desc: [
		"Aceleradores de Crescimento de Cristal energizados aceleram o crescimento de quartzo em brotamento adjacente."
		" "
		"Devem ser energizados pela parte superior ou inferior e consomem 8 ae/t constantes enquanto conectados."
	]
	quest.0000000000000C77.quest_subtitle: "Construa um Acelerador de Crescimento de Cristal"
	quest.0000000000000C79.quest_subtitle: "Construa alguns Cabos de Vidro ME de Fluix"
