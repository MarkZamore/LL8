	quest.00000000000001E6.quest_desc: [
		"Cabos Universais são a forma do Mekanism de transferir energia."
		" "
		"Capacidade: 3.27 MFE/t"
	]
	quest.00000000000001E6.quest_subtitle: "Fabrique 8x Cabos Universais Supremos"
	quest.00000000000001E6.title: "Cabo Universal Supremo"
	quest.00000000000001E8.quest_desc: ["Uma melhoria de máquina do Mekanism para fazê-las processar itens mais rápido. Cada máquina do Mekanism pode armazenar 8 dessas melhorias."]
	quest.00000000000001E8.quest_subtitle: "Fabrique uma Melhoria de Velocidade"
	quest.00000000000001EA.quest_desc: ["A melhoria de energia permite aumentar a capacidade de armazenamento de energia de uma máquina do Mekanism que tenha um slot de melhoria, bem como reduzir seu consumo de energia."]
	quest.00000000000001EA.quest_subtitle: "Fabrique uma Melhoria de Energia"
	quest.00000000000001EE.quest_desc: ["Uma melhoria de máquina do Mekanism para torná-las um pouco mais silenciosas. Instale 4 melhorias completas para abafar completamente os ruídos das máquinas."]
	quest.00000000000001EE.quest_subtitle: "Fabrique uma Melhoria de Abafamento"
	quest.00000000000001F0.quest_desc: ["A melhoria de gás permite aumentar a eficiência do uso de gás de uma máquina do Mekanism que a permita."]
	quest.00000000000001F0.quest_subtitle: "Fabrique uma Melhoria de Gás"
	quest.00000000000001F2.quest_desc: ["A Melhoria de Âncora é uma melhoria de máquina que mantém o chunk da máquina em que é aplicada carregado. Isso é útil para máquinas como o Minerador Digital e o Portal de Teletransporte, que devem estar em chunks carregados para funcionar corretamente."]
	quest.00000000000001F2.quest_subtitle: "Fabrique uma Melhoria de Âncora"
	quest.00000000000001F6.quest_desc: ["As fábricas são formas avançadas das máquinas básicas, destinadas a auxiliar no processamento de recursos em larga escala"]
	quest.00000000000001F6.quest_subtitle: "Fabrique uma Fábrica de Fundição Básica"
