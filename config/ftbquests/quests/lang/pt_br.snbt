	quest.0000000000000192.quest_desc: ["O item mais básico que a maioria das máquinas e geradores do Mekanism usa. Criado no Metallurgic Infuser infundindo uma Barra de Ferro com Redstone, Blocos de Redstone ou Redstone Comprimida."]
	quest.0000000000000192.quest_subtitle: "Fabrique Liga Enriquecida"
	quest.0000000000000194.quest_desc: ["Versão aprimorada da Liga Enriquecida que algumas máquinas e itens do Mekanism usam. Criada no Metallurgic Infuser infundindo uma Liga Enriquecida com Pó de Diamante ou Diamante Comprimido."]
	quest.0000000000000194.quest_subtitle: "Fabrique Liga Reforçada"
	quest.0000000000000196.quest_desc: ["Versão aprimorada da Liga Reforçada que algumas máquinas e itens do Mekanism usam. Criada no Metallurgic Infuser infundindo uma Liga Reforçada com Pó de Obsidiana Refinada ou Obsidiana Comprimida."]
	quest.0000000000000196.quest_subtitle: "Fabrique Liga Atômica"
	quest.0000000000000198.quest_desc: ["O Circuito de Controle Básico é um Componente de Criação usado na criação de várias máquinas de nível inferior."]
