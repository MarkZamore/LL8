	quest.00000000000001B8.quest_subtitle: "Fabrique um Cubo de Energia Supremo"
	quest.00000000000001BA.quest_desc: ["O Gerador Solar aproveita a luz do sol para gerar energia."]
	quest.00000000000001BA.quest_subtitle: "Fabrique um Gerador Solar"
	quest.00000000000001BC.quest_desc: [
		"O Gerador Solar Avançado é uma versão altamente aprimorada do Gerador Solar básico."
		" "
		"A construção de um Gerador Solar Avançado requer quatro Geradores Solares, mas produz seis vezes mais energia que seu primo menor."
		" "
		"Ele também requer uma área de 3x3x3 blocos para ser colocado."
	]
	quest.00000000000001BC.quest_subtitle: "Fabrique um Gerador Solar Avançado."
	quest.00000000000001BE.quest_desc: [
		"As pás gigantes de uma Turbina Eólica aproveitam a força do vento para gerar energia. Cada Turbina Eólica requer uma área razoavelmente grande de 1x1x5."
		" "
		"A máquina gerará energia dia e noite, sob sol ou chuva, mas a turbina deve ter uma visão clara do céu (sobre a carcaça do rotor no topo da torre)."
	]
	quest.00000000000001BE.quest_subtitle: "Fabrique um Gerador Eólico"
	quest.00000000000001C0.quest_desc: ["O Lança-chamas é uma arma de longo alcance que usa gás Hidrogênio como combustível. É bastante eficaz contra mobs, pois causa dano quando eles são atingidos diretamente pelo fluxo e os incendeia."]
	quest.00000000000001C0.quest_subtitle: "Fabrique um Lança-chamas"
	quest.00000000000001C2.quest_desc: ["O Desmontador Atômico é a ferramenta tudo-em-um do Mekanism, essencialmente a versão eletrônica definitiva do paxel."]
	quest.00000000000001C2.quest_subtitle: "Fabrique um Desmontador Atômico"
	quest.00000000000001C4.quest_desc: [
		"O Arco Elétrico funciona como o Arco vanilla e atira Flechas normais."
		" "
		"A diferença é que cada tiro não danifica, mas descarrega o arco. Se o armazenamento interno de energia estiver vazio, o arco não funciona e precisa ser recarregado, por exemplo, em um Cubo de Energia Básico."
	]
	quest.00000000000001C4.quest_subtitle: "Fabrique um Arco Elétrico"
	quest.00000000000001C6.quest_desc: [
		"As Botas de Corrida Livre são um item que permite aos jogadores subir inclinações de 1 bloco automaticamente (como o Cavalo), além de prevenir danos de queda, desde que estejam carregadas."
		""
		"Uma queda reduzirá a carga do item, dependendo da altura da queda."
	]
	quest.00000000000001C6.quest_subtitle: "Fabrique um par de Botas de Corrida Livre"
	quest.00000000000001C8.quest_desc: [
		"O Tablet de Energia é uma bateria portátil e recarregável que pode ser carregada com até 1.000kJ de energia e pode ser usada para alimentar outros dispositivos."
		" "
		"Também é um ingrediente em muitas receitas."
	]
	quest.00000000000001C8.quest_subtitle: "Fabrique um Tablet de Energia"
	quest.00000000000001CE.quest_desc: ["A Caixa Básica é um bloco de armazenamento que pode conter 4096 de um único item. Ela manterá seu inventário quando quebrada."]
	quest.00000000000001CE.quest_subtitle: "Fabrique uma Caixa Básica"
