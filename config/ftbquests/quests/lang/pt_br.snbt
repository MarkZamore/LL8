	quest.0000000000000C8E.quest_desc: [
		"Célula de Armazenamento de nível mais baixo, que pode conter 1.024 bytes de armazenamento."
		" "
		"1.024 bytes de armazenamento podem conter 127 Stacks de um único item. ou 65 Stacks, enquanto armazena 63 itens diferentes."
	]
	quest.0000000000000C8E.quest_subtitle: "Construa uma Célula de Armazenamento ME de 1k"
	quest.0000000000000C94.quest_desc: [
		"Célula de Armazenamento de nível mais baixo no AE2 normal, que pode conter 4.096 bytes de armazenamento."
		" "
		"4.096 bytes de armazenamento podem conter 508 Stacks de um único item. ou 260 Stacks, enquanto armazena 63 itens diferentes."
	]
	quest.0000000000000C94.quest_subtitle: "Construa uma Célula de Armazenamento ME de 4k"
	quest.0000000000000C96.quest_desc: [
		"Uma Célula de Armazenamento de nível intermediário no AE2 normal, que pode conter 16.384 bytes de armazenamento."
		" "
		"16.384 bytes de armazenamento podem conter 2.032 Stacks de um único item. ou 1.040 Stacks, enquanto armazena 63 itens diferentes."
	]
	quest.0000000000000C96.quest_subtitle: "Construa uma Célula de Armazenamento ME de 16k"
	quest.0000000000000C98.quest_desc: [
		"A segunda Célula de Armazenamento de nível mais alto no AE2 normal, que pode conter 65.536 bytes de armazenamento."
		" "
		"65.536 bytes de armazenamento podem conter 8.128 Stacks de um único item. ou 4.160 Stacks, enquanto armazena 63 itens diferentes."
	]
	quest.0000000000000C98.quest_subtitle: "Construa uma Célula de Armazenamento ME de 64k"
	quest.0000000000000CA9.quest_desc: [
		"Usado para criar diferentes tipos de Processadores."
		" "
		"O inscriber também pode \"criar\" prensas duplicando uma prensa existente com um Bloco de Ferro."
	]
	quest.0000000000000CA9.quest_subtitle: "Construa um Inscriber"
	quest.0000000000000CAB.quest_desc: ["Usado em várias receitas do AE2."]
	quest.0000000000000CAB.quest_subtitle: "Fabrique um Processador Lógico"
	quest.0000000000000CAD.quest_desc: ["Usado em várias receitas do AE2."]
	quest.0000000000000CAD.quest_subtitle: "Fabrique um Processador de Cálculo"
	quest.0000000000000CAF.quest_desc: ["Usado em várias receitas do AE2."]
	quest.0000000000000CAF.quest_subtitle: "Fabrique um Processador de Engenharia"
	quest.0000000000000CB1.quest_desc: ["Usado para ligar circuitos em um inscriber."]
	quest.0000000000000CB1.quest_subtitle: "Fabrique Silício Impresso"
	quest.0000000000000CB8.quest_desc: [
		"Células de Energia armazenam até 200.000 AE."
		""
		"Elas não aceitam energia diretamente, mas são usadas para adicionar armazenamento de energia adicional a uma Rede ME já existente."
	]
	quest.0000000000000CB8.quest_subtitle: "Fabrique uma Célula de Energia"
	quest.0000000000000CBA.quest_subtitle: "Fabrique alguns Núcleos de Aniquilação \\& Formação."
	quest.0000000000000CBA.title: "Os dois Núcleos"
	quest.0000000000000CC1.quest_desc: ["O Receptor de Energia é usado para converter energia de outros mods (por exemplo, Redstone Flux (RF)) em AE para alimentar redes ME."]
	quest.0000000000000CC1.quest_subtitle: "Construa um Receptor de Energia"
	quest.0000000000000CC7.quest_desc: ["Usado para criar Células de Armazenamento ME"]
