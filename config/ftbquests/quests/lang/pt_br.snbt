	quest.00000000000000B8.quest_subtitle: "Atire em algo com uma flecha."
	quest.00000000000000BA.quest_subtitle: "Mate um de cada monstro hostil do Vanilla."
	quest.00000000000000BC.quest_subtitle: "Mate um mob do tipo Esqueleto a mais de 50 blocos de distância (horizontalmente) da sua localização atual. (Não verticalmente)."
	quest.00000000000000BE.quest_subtitle: "Nota: Jogar fora sua única arma não é uma boa ideia."
	quest.00000000000000C0.quest_subtitle: "Atinja um Aldeão com um raio."
	quest.00000000000000C2.quest_subtitle: "Invoque um Golem de Ferro para ajudar a defender uma vila."
