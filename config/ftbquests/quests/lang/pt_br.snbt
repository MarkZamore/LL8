	quest.0000000000000236.quest_subtitle: "Fabrique uma Fábrica de Purificação Suprema"
	quest.0000000000000238.quest_desc: ["As fábricas são formas avançadas das máquinas básicas, destinadas a auxiliar no processamento de recursos em larga escala"]
	quest.0000000000000238.quest_subtitle: "Fabrique uma Fábrica de Injeção Suprema"
	quest.000000000000023A.quest_desc: ["As fábricas são formas avançadas das máquinas básicas, destinadas a auxiliar no processamento de recursos em larga escala"]
	quest.000000000000023A.quest_subtitle: "Fabrique uma Fábrica de Infusão Suprema"
	quest.000000000000023C.quest_desc: ["As fábricas são formas avançadas das máquinas básicas, destinadas a auxiliar no processamento de recursos em larga escala"]
	quest.000000000000023C.quest_subtitle: "Fabrique uma Fábrica de Serraria Suprema"
	quest.000000000000023E.quest_desc: ["Esta máquina usa energia para extrair pós de certos blocos e minérios, tornando-a essencial para produzir diferentes tipos de ferramentas. Não confundir com o Britador, esta máquina é o equivalente ao pulverizador em outros mods."]
	quest.000000000000023E.quest_subtitle: "Fabrique uma Câmara de Enriquecimento"
	quest.0000000000000242.quest_desc: ["O Combinador permite ao jogador criar um bloco de minério a partir de 8 pós. Coloque o pó de minério no slot superior e um pouco de pedregulho no slot inferior, e ele combinará para fazer o bloco de minério."]
	quest.0000000000000242.quest_subtitle: "Fabrique um Combinador"
	quest.0000000000000244.quest_desc: ["O Britador tritura, entre outras coisas, aglomerados em Pós Sujos, Barras em pós e Biomatéria em Biocombustível."]
	quest.0000000000000244.quest_subtitle: "Fabrique um Britador"
	quest.0000000000000246.quest_desc: [
		"O Infusor Metalúrgico é o primeiro passo na árvore de tecnologia do Mekanism."
		" "
		"É uma máquina usada na produção de Barras de Aço, Barras de Bronze, Liga Enriquecida e Barras de Obsidiana."
	]
	quest.0000000000000246.quest_subtitle: "Fabrique um Infusor Metalúrgico"
	quest.0000000000000248.quest_desc: ["A Câmara de Purificação usa oxigênio para refinar Minérios e fragmentos em aglomerados. Cada minério produz 3 aglomerados, enquanto cada fragmento dá apenas um aglomerado."]
	quest.0000000000000248.quest_subtitle: "Fabrique uma Câmara de Purificação"
	quest.000000000000024A.quest_desc: ["O fundidor energizado é a sua fornalha elétrica básica que usa energia em vez de combustível para derreter itens."]
	quest.000000000000024A.quest_subtitle: "Fabrique um Fundidor Energizado"
	quest.000000000000024C.quest_desc: [
		"O Condensador Rotativo (pronuncia-se \"con-DEN-sen-trador\") é usado para converter substâncias entre as formas líquida e gasosa a uma taxa de 1:1."
		" "
		"Ele tem dois modos: Decondensador, que transforma Líquidos em Gases, e Condensador, que transforma Gases em Líquidos."
	]
	quest.000000000000024C.quest_subtitle: "Fabrique um Condensador Rotativo"
	quest.000000000000024E.quest_desc: ["O Oxidante Químico é usado para fazer gases a partir de materiais. Seu lado esquerdo aceita materiais de entrada, enquanto seu lado direito dispensa o gás criado a partir desses materiais."]
	quest.000000000000024E.quest_subtitle: "Fabrique um Oxidante Químico"
	quest.0000000000000250.quest_desc: [
		"O Infusor Químico combina ou reage dois gases para criar outro gás."
		""
		"Os medidores de gás nos lados esquerdo e direito de sua GUI são os tanques de entrada e correspondem aos lados esquerdo и direito da máquina."
		" "
		"O medidor no meio é para o gás resultante, que da mesma forma é expelido pela frente da máquina."
	]
	quest.0000000000000250.quest_subtitle: "Fabrique um Infusor Químico"
	quest.0000000000000254.quest_desc: ["O Separador Eletrolítico envia quantidades controladas de corrente contínua para um fluido, fazendo com que os átomos no fluido quebrem suas ligações."]
	quest.0000000000000254.quest_subtitle: "Fabrique um Separador Eletrolítico"
	quest.0000000000000256.quest_desc: ["A Serraria de Precisão é usada para recuperar madeira de itens de madeira e transformar troncos em tábuas com um rendimento 50% melhor (6 em vez de 4). Também produz serragem para uso na fabricação da Caixa de Papelão."]
	quest.0000000000000256.quest_subtitle: "Fabrique uma Serraria de Precisão"
	quest.0000000000000258.quest_desc: ["A Câmara de Dissolução Química é a primeira máquina na configuração de processamento de minério x5."]
	quest.0000000000000258.quest_subtitle: "Fabrique uma Câmara de Dissolução Química"
	quest.000000000000025A.quest_desc: [
		"O Lavador Químico transforma o Slurry em Slurry Limpo usando Água. O slurry limpo precisa ser refinado bombeando-o para um Cristalizador Químico."
		" "
		"Note que, ao contrário da maioria das máquinas Mekanism, esta tem lados fixos de \"entrada\" e \"saída\" para o fluxo de minerais. A \"entrada\" estará à esquerda quando colocada pela primeira vez e a \"saída\" à direita."
	]
	quest.000000000000025A.quest_subtitle: "Fabrique um Lavador Químico"
	quest.000000000000025C.quest_desc: [
		"O Cristalizador Químico transforma o Slurry Limpo em Cristais e o lítio em pó de lítio."
		""
		"Esta é uma das poucas máquinas no Mekanism que tem lados dedicados e imutáveis para entrada e saída."
	]
	quest.000000000000025C.quest_subtitle: "Fabrique um Cristalizador Químico"
	quest.000000000000025E.quest_desc: [
		"A Câmara de Reação Pressurizada (PRC) é usada principalmente para criar Substrato (para criar Pellets de HDPE), Pellets de HDPE (para criar Folhas de HDPE) e Etileno (uma fonte eficiente de combustível usada no Gerador a Gás)."
		" "
		"Ela tem uma velocidade e uso de energia variáveis, dependendo dos materiais/gases que está criando."
	]
	quest.000000000000025E.quest_subtitle: "Fabrique uma Câmara de Reação Pressurizada"
	quest.0000000000000264.quest_desc: ["Obtido enriquecendo Obsidiana na Câmara de Enriquecimento."]
	quest.0000000000000264.quest_subtitle: "Obtenha um pouco de Pó de Obsidiana"
	quest.0000000000000266.quest_desc: ["Criado ao infundir Pó de Obsidiana com Pó de Diamante ou Diamante Comprimido no Infusor Metalúrgico."]
	quest.0000000000000266.quest_subtitle: "Fabrique Pó de Obsidiana Refinada"
	quest.0000000000000268.quest_desc: [
		"O Compressor de Ósmio é usado para criar Barras de Obsidiana Refinada a partir de Pó de Obsidiana Refinada e Barras de Pedra Luminosa a partir de Pó de Pedra Luminosa."
		""
		"Ele funde Ósmio líquido (Barras de Ósmio derretidas colocadas no slot inferior da máquina) com os materiais de origem para criar suas barras correspondentes."
	]
	quest.0000000000000268.quest_subtitle: "Fabrique um Compressor de Ósmio"
	quest.000000000000026C.quest_desc: ["A Barra de Obsidiana Refinada é uma barra criada colocando Pó de Obsidiana Refinada em um Compressor de Ósmio abastecido com Ósmio Líquido (de Barras de Ósmio)."]
	quest.000000000000026C.quest_subtitle: "Fabrique Barra(s) de Obsidiana Refinada"
	quest.000000000000026E.quest_desc: ["O Minerador Digital é a máquina de mineração em escala do Mekanism. No entanto, esta máquina não é como nenhuma outra, pois ela \"teletransporta magicamente\" os blocos minerados para seu inventário."]
	quest.000000000000026E.quest_subtitle: "Fabrique o Minerador Digital"
	quest.0000000000000270.quest_desc: [
		"O Entrelaçador Quântico é uma máquina que permite que líquidos/itens/energia/gás sejam enviados de um Entrelaçador Quântico para outro através de um canal."
		" "
		"O Entrelaçador Quântico é semelhante ao Tesseract de versões anteriores do Thermal Expansion, mas o Entrelaçador Quântico pode enviar e receber gases, enquanto o Tesseract não pode."
	]
	quest.0000000000000270.quest_subtitle: "Fabrique o Entrelaçador Quântico"
	quest.0000000000000272.quest_desc: ["O Núcleo de Teletransporte é um Componente de Criação usado na criação do Teletransportador Portátil, do Teletransportador e do Minerador Digital."]
	quest.0000000000000272.quest_subtitle: "Fabrique um Núcleo de Teletransporte"
	quest.0000000000000274.quest_desc: ["O Robit é o companheiro mecânico do Mekanism. Ele pode atuar como uma grade de criação, uma fornalha, uma bigorna, um baú ou simplesmente um amiguinho fofo."]
	quest.0000000000000274.quest_subtitle: "Fabrique um Robit"
	quest.000000000000027A.quest_desc: [
		"A Câmara de Injeção Química usa gás Cloreto de Hidrogênio para transformar minérios em 4 Fragmentos. É o início do processamento de minério 4x e requer um suprimento constante de Cloreto de Hidrogênio, que por sua vez exige que o jogador tenha uma Usina de Evaporação Térmica em funcionamento."
		" "
		"Ela também pode transformar Vapor de Água e Terra em Argila. Como a maioria das máquinas Mekanism, a Câmara de Injeção Química tem um bloco de Fábrica de si mesma."
	]
	quest.000000000000027A.quest_subtitle: "Fabrique uma Câmara de Injeção Química"
	quest.000000000000027C.quest_desc: ["A Revestimento de Aço é um bloco usado na receita de criação da maioria das máquinas do Mekanism."]
	quest.000000000000027C.quest_subtitle: "Fabrique um Revestimento de Aço"
	quest.000000000000027E.quest_desc: ["Criado pelo Infusor Metalúrgico, esta é a base a partir da qual o Pó de Aço pode ser obtido reprocessando-o no Infusor Metalúrgico."]
	quest.000000000000027E.quest_subtitle: "Fabrique Ferro Enriquecido"
	quest.0000000000000280.quest_desc: [
		"O Pó de Aço é produzido infundindo uma barra de ferro com 10 unidades de carbono (produzindo Ferro Enriquecido) e depois infundindo-o com mais 10 unidades de Carbono."
		" "
		"(Carbono = Carvão, Carvão Vegetal ou Carbono Refinado)"
	]
	quest.0000000000000280.quest_subtitle: "Fabrique Pó de Aço"
	quest.0000000000000280.title: "Pó de Aço"
	quest.0000000000000282.quest_desc: ["Uma Barra de Aço pode ser criada derretendo Pó de Aço em qualquer tipo de fornalha."]
	quest.0000000000000282.quest_subtitle: "Fabrique Barra(s) de Aço"
	quest.0000000000000282.title: "Barra de Aço"
	quest.0000000000000284.quest_desc: ["A Plataforma de Carga é uma estação de carregamento elétrico sem fio. Qualquer item recarregável que você tenha no seu inventário será carregado enquanto estiver sobre ela."]
	quest.0000000000000284.quest_subtitle: "Fabrique uma Plataforma de Carga"
	quest.0000000000000292.quest_desc: [
		"O Portal de Teletransporte é uma estrutura de múltiplos blocos que permite ao jogador se teletransportar entre Teletransportadores na mesma frequência."
		" "
		"Leia mais sobre isso na Wiki:"
		"https://wiki.aidancbrady.com/wiki/Teleporter_Portal"
	]
	quest.0000000000000292.quest_subtitle: "Fabrique os Componentes do Teletransportador"
	quest.0000000000000295.quest_desc: [
		"Barras de Pedra Luminosa são feitas colocando Pedra Luminosa em um Compressor de Ósmio energizado com Pedra Luminosa no slot superior e Barras de Ósmio no inferior."
		" "
		"Barras de Pedra Luminosa podem ser usadas para fazer Armadura de Pedra Luminosa, blocos de Pedra Luminosa Refinada e Estruturas de Teletransportador."
	]
	quest.0000000000000295.quest_subtitle: "Fabrique Barra(s) de Pedra Luminosa"
	quest.0000000000000299.quest_desc: [
		"Instaladores de Nível são usados para aprimorar várias máquinas para seu equivalente de Fábrica. Clique com o botão direito na máquina com o Instalador de Nível e ele aprimorará essa máquina"
		"- seu nível (Básico, Avançado ou Elite) dependendo do nível do Instalador de Nível usado."
	]
	quest.0000000000000299.quest_subtitle: "Fabrique um Instalador de Nível Básico"
	quest.000000000000029B.quest_desc: [
		"Instaladores de Nível são usados para aprimorar várias máquinas para seu equivalente de Fábrica. Clique com o botão direito na máquina com o Instalador de Nível e ele aprimorará essa máquina"
		"- seu nível (Básico, Avançado ou Elite) dependendo do nível do Instalador de Nível usado."
	]
	quest.000000000000029B.quest_subtitle: "Fabrique um Instalador de Nível Avançado"
	quest.000000000000029D.quest_desc: [
		"Instaladores de Nível são usados para aprimorar várias máquinas para seu equivalente de Fábrica. Clique com o botão direito na máquina com o Instalador de Nível e ele aprimorará essa máquina"
		"- seu nível (Básico, Avançado ou Elite) dependendo do nível do Instalador de Nível usado."
	]
	quest.000000000000029D.quest_subtitle: "Fabrique um Instalador de Nível de Elite"
	quest.000000000000029F.quest_desc: [
		"Instaladores de Nível são usados para aprimorar várias máquinas para seu equivalente de Fábrica. Clique com o botão direito na máquina com o Instalador de Nível e ele aprimorará essa máquina"
		"- seu nível (Básico, Avançado ou Elite) dependendo do nível do Instalador de Nível usado."
	]
	quest.000000000000029F.quest_subtitle: "Fabrique um Instalador de Nível Supremo"
	quest.00000000000002A3.quest_desc: [
		"Clique com o botão direito em um 'Extrator de Fluido' com um balde quando estiver em 1.000mb para obter um Balde de Látex."
		""
		"&7- Opcional."
	]
	quest.00000000000002A3.quest_subtitle: "Adquira um Balde de Látex"
	quest.00000000000002A6.quest_desc: ["Uma Estrutura de Máquina Simples usada em quase todas as máquinas do IF."]
	quest.00000000000002A6.quest_subtitle: "Fabrique uma Estrutura de Máquina Simples"
	quest.00000000000002AC.quest_subtitle: "Fabrique um Criador de Animais"
	quest.00000000000002AE.quest_subtitle: "Fabrique um Coletor de Plantas"
