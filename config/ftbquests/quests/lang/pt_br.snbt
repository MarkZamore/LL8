	quest.00000000000000DD.quest_subtitle: "Cruze dois animais."
	quest.00000000000000DF.quest_subtitle: "Use uma Fogueira para coletar Mel de uma Colmeia usando uma Garrafa sem irritar as abelhas."
	quest.00000000000000E1.quest_subtitle: "Plante uma semente e veja-a crescer."
	quest.00000000000000E3.quest_subtitle: "Coma tudo que for comestível, mesmo que não faça bem para você..."
	quest.00000000000000E5.quest_subtitle: "Use uma barra de netherita para aprimorar uma enxada e depois reavalie suas escolhas de vida"
