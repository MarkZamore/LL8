	quest.000000000000078D.quest_desc: ["&7O Vínculo de Processador é usado para criar diferentes tipos de Processadores."]
	quest.000000000000078D.quest_subtitle: "Fabrique 8x Vínculos de Processador."
	quest.000000000000078D.title: "Vínculo de Processador"
	quest.0000000000000795.quest_desc: ["&7O Processador Básico é usado para criar os vários dispositivos dentro do Refined Storage."]
	quest.0000000000000795.quest_subtitle: "Construa um Processador Básico."
	quest.0000000000000797.quest_desc: ["&7O Processador Melhorado é usado para criar os vários dispositivos dentro do Refined Storage."]
	quest.0000000000000797.quest_subtitle: "Construa um Processador Melhorado."
	quest.0000000000000799.quest_desc: ["O Processador Avançado é usado para criar os vários dispositivos dentro do Refined Storage."]
	quest.0000000000000799.quest_subtitle: "Fabrique um Processador Avançado."
	quest.000000000000079B.quest_desc: ["&7O Núcleo de Construção é usado em receitas para dispositivos que transformam itens da rede de armazenamento em itens no mundo."]
	quest.000000000000079B.quest_subtitle: "Fabrique um Núcleo de Construção."
	quest.000000000000079D.quest_desc: ["&7O Núcleo de Destruição é usado em receitas para dispositivos que transformam itens do mundo em itens na rede de armazenamento."]
	quest.000000000000079D.quest_subtitle: "Fabrique um Núcleo de Destruição."
	quest.000000000000079F.quest_desc: ["&7Processador Básico Bruto, usado em qualquer Fornalha para produzir um Processador Básico."]
	quest.000000000000079F.quest_subtitle: "Fabrique um Processador Básico Bruto."
	quest.00000000000007A1.quest_desc: ["&7Processador Melhorado Bruto, usado em qualquer Fornalha para produzir um Processador Melhorado."]
	quest.00000000000007A1.quest_subtitle: "Fabrique um Processador Melhorado Bruto."
	quest.00000000000007A3.quest_desc: ["&7Processador Avançado Bruto, usado em qualquer Fornalha para produzir um Processador Avançado."]
	quest.00000000000007A3.quest_subtitle: "Fabrique um Processador Avançado Bruto."
	quest.00000000000007AA.quest_desc: ["Ferro Enriquecido com Quartzo é usado em quase todas as receitas do Refined Storage."]
	quest.00000000000007AA.quest_subtitle: "Fabrique um pouco de Ferro Enriquecido com Quartzo."
	quest.00000000000007AA.title: "Ferro Enriquecido com Quartzo"
	quest.00000000000007AC.quest_desc: ["&7A Carcaça de Máquina pode ser usada para criar vários Dispositivos."]
	quest.00000000000007AC.quest_subtitle: "Construa uma Carcaça de Máquina."
	quest.00000000000007AE.quest_desc: [
		"&7O Controlador é o núcleo da rede Refined Storage. "
		""
		"&7Você precisa conectar todos os dispositivos Refined Storage a este bloco."
		""
		"&7&o(Você pode conectar dispositivos colocando-os bem ao lado do Controlador ou com cabos.)"
	]
	quest.00000000000007AE.quest_subtitle: "Construa um Controlador."
	quest.00000000000007B0.quest_desc: ["&7O Grid de Criação é o mesmo que um Grid regular, mas tem um inventário de criação. Permitindo que você crie itens com facilidade dentro da mesa."]
	quest.00000000000007B0.quest_subtitle: "Construa um Grid de Criação."
	quest.00000000000007B2.quest_desc: ["&7O Leitor de Disco é usado para armazenar seus Discos de Armazenamento criados. Um total de 8 discos pode ser armazenado em cada bloco de Leitor de Disco."]
	quest.00000000000007B2.quest_subtitle: "Construa um Leitor de Disco."
	quest.00000000000007B4.quest_desc: [
		"&7Um Disco de Armazenamento é um item onde os itens da rede de armazenamento são guardados. Ele precisa ser colocado em um Leitor de Disco."
		""
		"&7O Disco de Armazenamento de 1k pode armazenar 1.000 itens."
	]
	quest.00000000000007B4.quest_subtitle: "Fabrique um Disco de Armazenamento de 1k"
	quest.00000000000007B6.quest_desc: ["&7O Disco de Armazenamento de 4k pode armazenar 4.000 itens."]
	quest.00000000000007B6.quest_subtitle: "Fabrique um Disco de Armazenamento de 4k"
	quest.00000000000007B8.quest_desc: ["&7O Disco de Armazenamento de 16k pode armazenar 16.000 itens."]
	quest.00000000000007B8.quest_subtitle: "Fabrique um Disco de Armazenamento de 16k"
	quest.00000000000007BA.quest_desc: ["&7O Disco de Armazenamento de 64k pode armazenar 64.000 itens."]
	quest.00000000000007BA.quest_subtitle: "Fabrique um Disco de Armazenamento de 64k"
	quest.00000000000007BC.quest_desc: ["&7Partes de Armazenamento são usadas para criar Discos de Armazenamento \\& Partes de Armazenamento aprimoradas."]
	quest.00000000000007BC.quest_subtitle: "Fabrique uma Parte de Armazenamento de 1k"
	quest.00000000000007BE.quest_subtitle: "Fabrique uma Parte de Armazenamento de 4k"
	quest.00000000000007C0.quest_subtitle: "Fabrique uma Parte de Armazenamento de 16k"
	quest.00000000000007C2.quest_subtitle: "Fabrique uma Parte de Armazenamento de 64k"
	quest.00000000000007CF.quest_desc: ["&7O Grid é um bloco que permite acesso aos itens e fluidos na rede de armazenamento."]
	quest.00000000000007CF.quest_subtitle: "Construa um Grid."
	quest.0000000000000988.quest_subtitle: "A Cruz da Misericórdia é uma arma que causa dano extra a mobs mortos-vivos."
	quest.000000000000098A.quest_subtitle: "Frasco de proteção da morte - quebra quando o jogador morreria, restaura um pouco de vida e dá ao jogador alguns efeitos úteis."
	quest.000000000000098C.quest_subtitle: "Pena Angelica protege contra danos de queda. Em uma queda que machucaria o jogador, em vez disso, drena a fome do jogador."
	quest.000000000000098E.quest_subtitle: "Moeda da Fortuna, quando ligada, teleporta itens e experiência dentro do alcance para o jogador. Se o botão direito for segurado com a moeda na mão, o alcance em que os itens e a experiência são teleportados é maior."
	quest.0000000000000990.quest_desc: [
		"No modo olho do ender, as pérolas do ender arremessadas vão mais longe e mais rápido. Em ambos os modos, quando a pérola do ender atinge, ela teleporta o jogador de uma maneira muito mais segura do que a pérola do ender vanilla."
		" "
		"No modo nó do espectro, o cajado do ender teleporta o jogador para o nó do espectro ao qual está definido (clicando com o botão direito com o cajado do ender no nó do espectro)."
	]
	quest.0000000000000990.quest_subtitle: "O Cajado do Ender é uma ferramenta de teletransporte. No modo pérola do ender, ele permite arremessar pérolas do ender de maneira semelhante ao que você faria apenas com pérolas do ender na mão."
	quest.0000000000000992.quest_desc: [
		"Quando ligado, ele drena estes do inventário do jogador e também congela lava (em obsidiana) e água (em gelo compactado) ao alcance do jogador, permitindo andar sobre lava e água."
		" "
		"Esses blocos congelados derreterão rapidamente de volta quando fora do alcance."
	]
	quest.0000000000000992.quest_subtitle: "O Cajado Glacial é uma arma de longo alcance que atira bolas de neve a partir de sua carga."
	quest.0000000000000994.quest_subtitle: "O Cálice Infernal contém lava e, com base no modo em que está, você pode usá-lo para colocar ou remover lava no mundo."
	quest.0000000000000996.quest_subtitle: "A Lanterna da Paranoia, quando ligada, procura por pontos escuros ao redor do jogador e coloca tochas neles, seja do inventário do jogador ou do Cajado do Viajante."
	quest.0000000000000998.quest_desc: [
		"Então você pode usá-lo para colocar ou remover água no mundo, mas também pode ser usado com o Caldeirão de Boticário, o Boticário de Pétalas do Botania e o Crisol do Thaumcraft."
		" "
		"Você também pode usá-lo para reabastecer sua fome em troca de um pouco de vida."
	]
	quest.0000000000000998.quest_subtitle: "O Cálice do Imperador é tanto um balde de água infinito quanto um balde vazio, dependendo do modo em que está."
	quest.000000000000099A.quest_desc: ["Caso o jogador morresse de outra forma, ele cura o jogador e o fortalece com alguns efeitos úteis."]
	quest.000000000000099A.quest_subtitle: "A Pena de Fênix é uma versão aprimorada da Pena Angélica. Ela também previne danos de queda em troca da fome do jogador, mas também pode prevenir a morte."
	quest.000000000000099C.quest_subtitle: "O Medalhão do Herói armazena experiência. Quando ligado, ele a drena do jogador. Quando desligado, o jogador pode retirar um nível dele por clique com o botão direito."
	quest.000000000000099E.quest_subtitle: "Um dos melhores itens de comida do jogo. Enche completamente a fome e a saturação."
	quest.00000000000009A0.quest_subtitle: "O Cajado do Viajante contém muitas tochas que você pode colocar clicando com o botão direito. Ele também pode colocar tochas à distância por um custo maior de tochas."
	quest.00000000000009A2.quest_subtitle: "O Vento Rasgante no modo de voo permite que o jogador voe apontando e clicando com o botão direito. Ele também pode empurrar ou puxar mobs e, se chover, há um modo Raio disponível que permite gerar relâmpagos."
	quest.00000000000009A4.quest_subtitle: "Quando segurado, apaga fogos ao redor do jogador, também pode refletir bolas de fogo de ghasts atiradas no jogador."
	quest.00000000000009A6.quest_desc: [
		"No modo pó de blaze e carga de fogo, ele atira bolas de fogo do tamanho de blazes e ghasts. No modo Erupção, ele queima qualquer coisa ao alcance na frente do jogador."
		" "
		"E o modo Pederneira e Isqueiro funciona exatamente como a pederneira e isqueiro vanilla. Ele também destrói quaisquer bolas de fogo atiradas no jogador e apaga fogos quando desligado."
	]
	quest.00000000000009A6.quest_subtitle: "O Cajado do Piromante tem múltiplos modos, todos relacionados ao fogo."
	quest.00000000000009A8.quest_subtitle: "Atira bolas de slime nos inimigos."
	quest.00000000000009AA.quest_subtitle: "Faz com que os mobs ignorem o jogador durante a noite, mesmo que sejam atingidos pelo jogador."
	quest.00000000000009AC.quest_desc: [
		"Ele pode arar a terra, manter sementes/plantáveis em seu inventário e plantá-los, e manter farinha de osso em seu inventário e adubar com ela."
		""
		"Tudo isso pode ser feito em um bloco para o qual o jogador está apontando com um simples clique direito ou em uma área de efeito segurando o clique direito. Ele também quebra todas as colheitas em seu alcance quando o jogador quebra uma, então ajuda a acelerar a colheita também."
	]
	quest.00000000000009AC.quest_subtitle: "A Vara de Colheita é uma ferramenta de auxílio ao agricultor."
	quest.00000000000009C1.quest_subtitle: "Se estiver no inventário do jogador, impede que ele sofra o efeito Wither."
	quest.00000000000009C4.quest_subtitle: "Impede que o jogador se machuque no fogo em troca de fome."
	quest.00000000000009C8.quest_subtitle: "Explosivo arremessável poderoso que pode matar a maioria dos mobs com um só golpe."
	quest.00000000000009D3.quest_subtitle: "Pesque um Bacalhau do Atlântico!"
	quest.00000000000009D5.quest_subtitle: "Pesque um Peixe-Negro!"
	quest.00000000000009D7.quest_subtitle: "Pesque um Halibute do Pacífico!"
	quest.00000000000009D9.quest_subtitle: "Pesque um Halibute do Atlântico!"
	quest.00000000000009DB.quest_subtitle: "Pesque um Arenque do Atlântico!"
	quest.00000000000009DD.quest_subtitle: "Pesque um Salmão Rosa!"
	quest.00000000000009DF.quest_subtitle: "Pesque um Pollock!"
	quest.00000000000009E1.quest_subtitle: "Pesque uma Truta Arco-Íris!"
	quest.00000000000009E3.quest_subtitle: "Pesque um Bayad!"
	quest.00000000000009E5.quest_subtitle: "Pesque um Capitaine!"
	quest.00000000000009E7.quest_subtitle: "Pesque um Synodontis!"
