	quest.000000000000006B.quest_subtitle: "Distraia Piglins com ouro"
	quest.000000000000006D.quest_subtitle: "Acerte o centro de um Bloco de Alvo a pelo menos 30 metros de distância"
	quest.00000000000000B0.quest_subtitle: "Faça uma troca bem-sucedida com um Aldeão."
	quest.00000000000000B2.quest_subtitle: "Mate qualquer monstro hostil"
	quest.00000000000000B4.quest_subtitle: "Mate um capitão de incursão."
