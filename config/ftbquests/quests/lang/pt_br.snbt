	quest.0000000000000CCB.quest_subtitle: "Construa um Componente de Armazenamento ME de 16k"
	quest.0000000000000CCD.quest_desc: ["Usado para criar Células de Armazenamento ME"]
	quest.0000000000000CCD.quest_subtitle: "Construa um Componente de Armazenamento ME de 64k"
	quest.0000000000000CDA.quest_desc: [
		"O Fogo Espiritual é criado jogando uma fruta do sonho do demônio no chão e acendendo-a com pederneira e isqueiro."
		""
		"Isso queimará temporariamente em blocos normais, mas é perpétuo em troncos, blocos de carvão ou netherrack."
		"{image:occultism:textures/gui/book/spiritfire_instructions.png width:100 height:100 align:1}"
	]
	quest.0000000000000CDA.quest_subtitle: "Liberte seu incendiário interior"
	quest.0000000000000CDA.title: "Olha, mãe, não queima!"
	quest.0000000000000CDE.quest_subtitle: "Aniquile um Shulker"
	quest.0000000000000CDE.title: "Levitação? Não mais!"
	quest.0000000000000CF7.quest_desc: [
		"O Espírito Britador Foliot será seu primeiro espírito que você pode invocar."
		""
		"Este espírito será bom em um aperto se você não tiver feito nenhum outro meio para triturar minérios."
		""
		"No entanto, se você progredir, os espíritos trituradores mais poderosos produzem mais resultados e podem valer a pena."
	]
	quest.0000000000000CF7.quest_subtitle: "Deixe-me falar sobre meu melhor amigo"
	quest.0000000000000CF7.title: "Triture sem parar"
	quest.0000000000000D92.quest_desc: [
		"Para fazer as velas que você precisará para seus rituais, você precisará de sebo obtido ao matar animais."
		""
		"Usando a faca de açougueiro, você pode abater animais e obter sebo para fazer as velas."
		""
		"Nota: Você precisará de bastante sebo para todas as velas, mas pode usar outras velas se forem mais fáceis de fazer."
	]
	quest.0000000000000D92.quest_subtitle: "Oh, o horror..."
	quest.0000000000000D92.title: "Fábrica de abate"
	quest.0000000000000D96.quest_desc: [
		"Tinta Purificada é feita jogando corante preto no fogo espiritual"
		""
		"Tinta purificada é necessária para todos os Livros de Vínculo usados no ocultismo, mas felizmente seus deuses da missão lhe deram um pouco para começar."
	]
	quest.0000000000000D96.title: "Limpe sua Tinta"
	quest.0000000000000D98.quest_desc: [
		"O Giz é uma ferramenta necessária para desenhar runas necessárias nos próximos pentáculos rituais."
		""
		"O primeiro giz que você cria é o giz branco e precisará ser jogado no fogo demoníaco para torná-lo utilizável."
	]
	quest.0000000000000D9A.quest_desc: ["Ahh, não está melhor? Giz bonito e limpo, e agora pode ser usado para desenhar seus rituais."]
	quest.0000000000000D9A.title: "Giz Branco"
	quest.0000000000000D9C.quest_desc: [
		"O Giz Dourado é o próximo nível de giz usado para rituais um pouco mais avançados."
		""
		"Isso requer um pouco de ouro e Pedra Luminosa, mas você sabia que pode obter Pedra Luminosa sem ir para o nether macerando líquen brilhante ou frutas brilhantes? Já começou Botania, você pode obtê-lo do botania facilmente também; verifique o JEI para todas as opções."
	]
	quest.0000000000000D9C.quest_subtitle: "Oooooooh Brilhante!!"
	quest.0000000000000D9C.title: "Giz Dourado"
	quest.0000000000000D9E.quest_desc: ["O Giz Roxo é outra cor de giz no arsenal do ocultista. Ele permite que você vincule espíritos mais poderosos, como o Djinni."]
	quest.0000000000000D9E.quest_subtitle: "Comece a Desenhar Roxo Para Mim Agora!!!"
	quest.0000000000000DA0.quest_desc: [
		"O último giz que você fará é o giz vermelho, usado nas receitas mais avançadas que serão usadas em rituais avançados, como chamar o Marid."
		""
		"Se você ainda não foi ao nether ou não encontrou nenhum blaze, existem maneiras inteligentes de obter pó de blaze."
		"Você pode encontrar blocos de magma por todo o mundo superior e oceanos, que se maceram em creme de magma, que se macera em pó de blaze."
		""
		"O quê, você ainda não tem um macerador? Adquira um, super útil!"
	]
	quest.0000000000000DA4.quest_desc: [
		"O Atuador de Armazenamento Dimensional é sua porta de entrada para armazenar itens no Outro Mundo!"
		""
		"Começa bem pequeno, mas seu armazenamento pode ser expandido adicionando até 6 Estabilizadores (um em cada lado) apontando para o atuador."
	]
	quest.0000000000000DA8.quest_desc: [
		"Os Estabilizadores de Armazenamento Dimensional estabilizam a conexão do seu atuador com o Outro Mundo."
		""
		"Quanto mais estável for sua conexão, mais você poderá armazenar!"
		""
		"Até 6 estabilizadores podem ser adicionados a qualquer Atuador. Cada Nível aumentará a estabilidade, permitindo que você armazene mais e mais itens no Outro Mundo."
		""
		"Eles precisam ser colocados de frente para a porção Matriz do seu atuador e podem estar a até 5 blocos de distância. Um estabilizador pode ser colocado em cada direção, as direções cardeais, bem como acima e abaixo do atuador."
		"{image:occultism:textures/gui/book/storage_stabilizer.png width:100 height:100 align:1}"
	]
	quest.0000000000000DAA.quest_desc: ["Precisamos de MAIS!"]
	quest.0000000000000DAC.quest_desc: ["Eu disse MAIS!!"]
	quest.0000000000000DAE.quest_desc: [
		"Estou dando tudo de si, Capitão!"
		""
		"Imagine 6 desses carinhas guardando o Loot do mundo!"
	]
	quest.0000000000000DB2.quest_desc: ["O Acessor de Armazenamento é um tablet usado para acessar seu armazenamento remotamente de qualquer distância E através de todas as dimensões!!!"]
	quest.0000000000000DBA.quest_desc: [
		"O Buraco de Minhoca Estável é um objeto que pode ser colocado permitindo que você acesse seu armazenamento em qualquer dimensão, bem como transporte coisas para dentro e para fora de seu armazenamento."
		""
		"O buraco de minhoca tem implicações muito poderosas quando usado com outros mods de armazenamento, como o Refined Storage ou o AE2."
		""
		"Uma configuração muito comum é usar um barramento de armazenamento externo no buraco de minhoca estável e agora você tem uma capacidade de armazenamento REALMENTE grande."
	]
	quest.0000000000000DBC.quest_desc: [
		"A Gema da Alma permite que você pegue qualquer mob, exceto os mais poderosos do mundo."
		""
		"Muito útil para transportar sacrifícios para seus rituais!"
		""
		"Coloque a Gema da Alma em sua mão e clique com o botão direito em qualquer mob com ela, o mob será armazenado na gema da alma para ser colocado de volta no mundo a qualquer momento com outro clique direito!"
	]
	quest.0000000000000DBC.quest_subtitle: "Isso é um Mob no seu bolso, ou você está feliz em me ver?"
	quest.0000000000000DBC.title: "Gema da Alma"
	quest.0000000000000DBE.quest_desc: [
		"Os Óculos do Outro Mundo permitem que você veja materiais de outro mundo, fornecendo um efeito permanente de \"Terceiro Olho\" sem ter que comer Fruta do Sonho do Demônio."
		""
		"NOTA: Os óculos são a única maneira de ver e, consequentemente, minerar minério de iesnium no nether."
		""
		"Os óculos também cabem em um slot de curio para que você possa mantê-los equipados o tempo todo."
	]
	quest.0000000000000DBE.quest_subtitle: "Eu Uso Meus Óculos do Outro Mundo à Noite"
	quest.0000000000000DC2.quest_desc: ["A Picareta de Iesnium tem as mesmas estatísticas de uma picareta de diamante normal com o bônus adicional de que é capaz de minerar Minério de Iesnium."]
	quest.0000000000000DC4.quest_desc: [
		"Ainda não foi ao fim? Uma maneira de obter Pedra do End é invocando um endermite."
		""
		"O ritual invocará um endermite e garantirá a queda de 1-2 Pedras do End quando morto."
		""
		"Agora você pode fazer seu giz roxo."
	]
	quest.0000000000000DC6.quest_desc: ["Precisa de crânios para seus rituais? Isso lhe dará quedas de crânio garantidas."]
	quest.0000000000000DCA.quest_desc: [
		"O Poço de Mina Dimensional abre um portal para uma dimensão desabitada cheia de todos os tipos de minérios esperando para serem minerados."
		""
		"O único problema é que o portal é muito pequeno para um humano normal passar."
		""
		"Isso não é um problema para os espíritos, no entanto, você precisará invocar um dos espíritos de mineração para adquirir os minérios para você."
	]
	quest.0000000000000DCC.quest_desc: [
		"O Espírito de Mineração Foliot é colocado no poço de mina dimensional e retorna minérios e vários blocos de pedra."
		""
		"No entanto, sendo um espírito mais fraco, é lento e fica sem energia rapidamente."
	]
	quest.0000000000000DCE.quest_desc: [
		"O Espírito de Mineração Djinni é muito mais forte que sua contraparte Foliot. Leva muito menos tempo para este espírito mais forte viajar de e para a dimensão de mineração, e ele pode trazer mais minérios a cada viagem!"
		""
		"A durabilidade deste mineiro foi aumentada neste pacote, você não verá essa mudança até que o mineiro perca seu primeiro ponto de durabilidade no poço de mina."
	]
	quest.0000000000000DD0.quest_desc: [
		"Normalmente, minérios de outro mundo, como o Iesnium, só podem ser minerados com ferramentas feitas de materiais de outro mundo."
		""
		"O ocultista, no entanto, tem a capacidade de infundir uma picareta com um espírito para permitir que eles minem esses minérios. O processo de infusão enfraquece severamente a ferramenta, reduzindo sua durabilidade grandemente."
	]
	quest.0000000000000DD2.quest_desc: ["Cristais Sintonizados com Espírito são usados em alguns padrões de rituais e itens usados em receitas de rituais."]
	quest.0000000000000DD6.quest_desc: [
		"Tigelas de Sacrifício serão usadas em seus rituais para colocar seus itens para realizar os rituais."
		""
		"Elas podem estar em qualquer lugar a até 8 blocos de distância da tigela dourada central."
	]
	quest.0000000000000DD8.quest_desc: [
		"A tigela sacrificial dourada vai no centro de cada ritual."
		""
		"Você precisará de uma por ritual."
	]
	quest.0000000000000DDA.quest_desc: ["Cometeu um erro com seu giz? Você pode quebrar o giz, mas leva muito tempo para quebrar, então clicar com o botão direito com um pincel o remove instantaneamente."]
	quest.0000000000000DDA.quest_subtitle: "Erros acontecem"
	quest.0000000000000DDA.title: "Pincele o mal para longe"
	quest.0000000000000DE0.quest_desc: [
		"Para invocar espíritos mais poderosos, você precisará da Essência de Afrit."
		""
		"Esta essência só pode ser adquirida invocando um Espírito Afrit Desvinculado para este plano mortal e derrotando-o."
		""
		"Isso, no entanto, não é tarefa fácil, pois o Afrit é forte e invocará vários lacaios para lutar ao seu lado."
		""
		"Derrote o Afrit para reivindicar sua essência."
	]
	quest.0000000000000DE4.quest_desc: [
		"Crânios de Esqueleto Wither podem ser um aborrecimento para conseguir às vezes."
		""
		"Para aqueles que não desejam enfrentar o mundo infernal que é o Nether, temos o Ritual da Caçada Selvagem."
		""
		"O Ritual da Caçada Selvagem invocará vários Esqueletos Wither Possuídos, bem como seus lacaios de Esqueleto Possuído. Cada Esqueleto Wither Possuído tem a garantia de soltar pelo menos um Crânio de Esqueleto Wither."
		""
		"Esses Esqueletos Wither também têm a chance de soltar algum Loot extra!!!"
	]
	quest.0000000000000DE4.title: "Invoque a Caçada Selvagem"
	quest.0000000000000DE6.quest_desc: [
		"Iesnium é um minério de outro mundo encontrado no Nether. Usar sua Vara de Adivinhação deve permitir que você o encontre rapidamente."
		""
		"Óculos do Outro Mundo ou Fruta do Sonho do Demônio podem ajudá-lo a ver o material, mas você não precisa do efeito do Terceiro Olho para minerá-lo. Embora você precise de uma Picareta Infundida ou uma Picareta de Iesnium."
	]
	quest.0000000000000DE6.quest_subtitle: "Adivinhação 2: O Retorno Ocultista"
	quest.0000000000000E00.quest_desc: [
		"Cansado de comer Fruta do Sonho do Demônio? Ainda não fez os óculos de outro mundo? Tenho uma oferta para você!"
		""
		"Invoque o Comerciante de Mudas do Outro Mundo e ele converterá suas mudas instáveis em versões estáveis para que você possa ver e colher as árvores normalmente."
	]
	quest.0000000000000E04.quest_desc: [
		"O espírito lenhador Foliot pode colher aquelas árvores irritantes que continuam crescendo regularmente."
		""
		"O alcance do espírito Lenhador pode chegar a 64x64"
	]
	quest.0000000000000E0A.quest_desc: [
		"O Transportador Foliot é mais um familiar que você pode invocar e levar em suas aventuras."
		""
		"O Transportador Foliot pode transferir itens uma pilha de cada vez entre dois inventários."
	]
	quest.0000000000000E0A.title: "Invocar Espírito Transportador Foliot"
