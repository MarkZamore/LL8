	quest.000000000000031F.quest_desc: [
		"Borracha Seca é adquirida colocando Látex \\& Água em uma Unidade de Processamento de Látex."
		" "
		"Látex é produzido colocando uma Tora na frente de um Extrator de Fluido. Ele produzirá Látex lentamente."
	]
