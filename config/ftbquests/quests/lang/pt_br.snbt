	quest.0000000000000325.quest_subtitle: "Adquirido ao canalizar Pink Slime para qualquer Tanque usando Tubos Mecânicos do Mekanism ou algo semelhante."
	quest.0000000000000327.quest_desc: [
		"Pink Slime é adquirido colocando o balde de Pink Slime na Câmara de Dissolução e, em seguida, colocando 1 Painel de Vidro."
		""
		"&o(Clique no Pink Slime para ver a receita.)"
	]
	quest.0000000000000327.quest_subtitle: "Adquira Pink Slime"
	quest.00000000000003EE.quest_desc: ["&7> Esta doca pode ser colocada e usada como um baú se um Banco for armazenado dentro dela."]
	quest.00000000000003EE.quest_subtitle: "Fabrique uma Doca de Banco"
	quest.0000000000000450.quest_desc: [
		"Powah é um mod de tecnologia que adiciona várias maneiras de gerar, armazenar e transmitir Energia Forge."
		""
		"Ele fornece vários tipos diferentes de geradores de energia, desde o clássico gerador a carvão até o reator multiblock de auto-construção."
		""
		"Todas as máquinas do Powah são baseadas em níveis. Você começará com as máquinas apropriadamente nomeadas \"iniciantes\" e as aprimorará à medida que avança."
		""
		"Os níveis são os seguintes: Iniciante, Básico, Endurecido, Flamejante, Niótico, Vibrante e Nitro."
	]
	quest.0000000000000450.quest_subtitle: "Um começo pastoso!"
	quest.000000000000045A.quest_desc: [
		"Pode ser usado para capturar qualquer Mob, útil para muitas coisas."
		""
		"A Ferramenta de Aprisionamento de Mob pode ser usada quantas vezes você quiser."
		" "
	]
