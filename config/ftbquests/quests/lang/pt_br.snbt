	quest.00000000000002E8.quest_desc: [
		"Obtido ao soltar redstone entre Obsidiana \\& Rocha Matriz."
		""
		"Obsidiana em cima e rocha matriz embaixo - solte redstone entre eles e clique com o botão esquerdo na obsidiana."
		""
		"&o*ruídos altos*- Flux!"
		""
		"Não há limite para a quantidade de Pó de Redstone que você pode usar, a cada vez."
	]
	quest.00000000000002E8.quest_subtitle: "Obtenha um pouco de Flux"
	quest.00000000000002EC.quest_desc: [
		"O carregamento de inventário pode ser configurado na Aba de Carregamento Sem Fio."
		" "
		"Apenas um controlador pode ser conectado a uma rede por vez."
		""
		"A 'Saída' do controlador se refere à energia emitida da rede via Carregamento Sem Fio."
		" "
		"&lRedes não precisam de um &lControlador de Flux para operar"
	]
	quest.00000000000002EC.quest_subtitle: "Necessário para ativar o carregamento de inventário interdimensional."
	quest.00000000000002EE.quest_desc: ["Leia mais sobre Flux Networks na Wiki deles: https://github.com/SonarSonic/Flux-Networks/wiki"]
	quest.00000000000002EE.quest_subtitle: "O ingrediente de criação chave para Flux Networks"
	quest.00000000000002EE.title: "Núcleo de Flux"
	quest.00000000000002F0.quest_desc: [
		"O Armazenamento de Flux é usado para guardar o excesso de energia. Ele só será preenchido quando cada Ponto de Flux tiver recebido energia suficiente."
		""
		"&oLimite de Transferência: 20000"
		""
		"Esta energia só pode ser acessada removendo energia com um Ponto de Flux."
		""
		"&lRedes não precisam de um &lArmazenamento de Flux para operar."
	]
	quest.00000000000002F0.quest_subtitle: "Usado para Armazenar Energia na rede"
	quest.00000000000002F4.quest_desc: ["(Você pode adicionar energia de todos os lados simultaneamente.)"]
	quest.00000000000002F4.quest_subtitle: "Usado para Adicionar Energia à rede"
	quest.00000000000002F6.quest_desc: ["(Você pode remover energia de todos os lados simultaneamente.)"]
	quest.00000000000002F6.quest_subtitle: "Usado para Remover Energia da rede"
	quest.00000000000002FC.quest_desc: [
		"Ele também pode ser usado para copiar/colar configurações entre conectores."
		""
		"Shift-Clique com o botão direito em um conector para copiar suas configurações e, em seguida, clique com o botão direito em um conector para o qual deseja colar as configurações."
		""
		"Se você clicar com o botão direito em algo que não seja um conector, abrirá a GUI da Rede e também poderá editar as configurações que o Configurador irá colar."
		""
		"O configurador também pode ser renomeado aqui, com o campo de nome."
	]
	quest.00000000000002FC.quest_subtitle: "Pode ser usado para acessar, editar, deletar redes em movimento."
	quest.0000000000000302.quest_desc: [
