# === Energized Power - Farmer's Delight Common Config (IMPORTANT: Not all values are synced from the server to the client.) ===

# The config version of this config file
# [Default value]: 3.0.0-beta.2
# [Validation]: This value should not be changed
config_version = 3.0.0-beta.2

# The energy capacity of the Electric Stove in FE
# [Default value]: 1024
# [Validation]: Value >= 1
block.electric_stove.capacity = 1024

# The energy transfer rate of the Electric Stove in FE per tick
# [Default value]: 32
# [Validation]: Value >= 1
block.electric_stove.transfer_rate = 32

# The energy consumption of the Electric Stove if active in FE per tick
# [Default value]: 8
# [Validation]: Value >= 1
block.electric_stove.energy_consumption_per_tick = 8

# The multiplier by which the time a recipe of the skillet and cooking pot using the Electric Stove requires is multiplied by (Integer only).
# [Default value]: 2
# [Validation]: Value >= 1
block.electric_stove.recipe_duration_multiplier = 2

# The energy capacity of the Induction Stove in FE
# [Default value]: 2048
# [Validation]: Value >= 1
block.induction_stove.capacity = 2048

# The energy transfer rate of the Induction Stove in FE per tick
# [Default value]: 64
# [Validation]: Value >= 1
block.induction_stove.transfer_rate = 64

# The energy consumption of the Induction Stove if active in FE per tick
# [Default value]: 16
# [Validation]: Value >= 1
block.induction_stove.energy_consumption_per_tick = 16

# The multiplier by which the time a recipe of the skillet and cooking pot using the Induction Stove requires is multiplied by (Integer only).
# [Default value]: 3
# [Validation]: Value >= 1
block.induction_stove.recipe_duration_multiplier = 3
